package main

import (
	"fmt"
	"io/ioutil"
	"os"
	"sort"
	"strings"
)

func main() {
	sliceData := file.ReadString()

	emptySlice := sliceData.UniqueValue()

	emptySlice:=emptySlice.Upper()

	sort.Strings(emptySlice)

	file, err := os.Create("hw1.txt")
	emptySlice.WriteString()
}

func UniqueValue(sliceData []string{}){
	for i := 0; i < len(sliceData); i++ {
		k := 0
		for g := 0; g < len(sliceData)-1; g++ {

			if sliceData[i] == sliceData[g] {
				k++
			}
		}

		if k == 1 {
			emptySlice = append(emptySlice, sliceData[i])
		}
	}
	return emptySlice
}

func Upper(EmptySlice[]string{}){
	for i := 0; i < len(emptySlice); i++ {
		emptySlice[i] = strings.ToUpper(emptySlice[i])
	}
	return emptySlice
}

func ReadString(file){
	if len(os.Args) <= 1 {
		fmt.Printf("USAGE : %s <target_filename> \n", os.Args)[0]
		return 1
	}
	fileName := os.Args[1]("")

	fileBytes, err := ioutil.ReadFile(fileName)
	if err != nil {
		fmt.Println(err)
		return 1
	}
	
	sliceData := strings.Split(string(fileBytes), "\n")
	file.Close()
	return (sliceData)
}

func WriteString(EmptySlice){
	if err != nil {
		fmt.Println(err)
		return 1
	}
	for i := 0; i < len(emptySlice); i++ {

		text := emptySlice[i]
		n := len(emptySlice[i])

		if err != nil {
			fmt.Println("Unable to create file:", err)
			return 1
		}

		file.WriteString(text)
		file.WriteString("-")
		file.WriteString(string(n), '\n')
	}

	fmt.Println("Done.")
	defer file.Close()
	return file	
}
